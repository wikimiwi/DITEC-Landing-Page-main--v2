# Copie este arquivo para .env (ou exporte as variaveis no seu sistema/IDE)
# NUNCA COMITE O .env COM VALORES REAIS.

DB_URL=jdbc:mysql://localhost:3306/ditec_assistencia?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true
DB_USERNAME=ditec_user
# OBRIGATORIA — sem valor padrao. A aplicacao recusa subir sem isso definido
# (evita conectar silenciosamente com uma senha fraca/previsivel).
DB_PASSWORD=uma-senha-forte-local

# Gere um valor aleatorio de pelo menos 32 caracteres, ex:
#   openssl rand -base64 48
# OBRIGATORIA — sem valor padrao. A aplicacao recusa subir sem isso definido.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres
JWT_EXPIRATION_MINUTES=120

# Chave da Hugging Face (https://huggingface.co/settings/tokens) — precisa
# do escopo "Make calls to Inference Providers". NUNCA exponha no frontend.
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Origens permitidas por CORS (o Live Server do VS Code costuma usar 5500)
DITEC_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Popula dados de teste no primeiro start (admin/cliente/tecnico/OS de exemplo).
# NUNCA deixe true em producao — ha' tambem uma trava automatica que recusa
# semear se o profile ativo contiver "prod" (ver SECURITY.md).
DITEC_SEED_ENABLED=true

# Protecao contra forca bruta/spam em login, cadastro, chatbot, agendamento e
# avaliacao (ver SECURITY.md, secao 1). Mantenha true em qualquer ambiente
# real — so' e' desligado automaticamente no perfil de testes automatizados.
DITEC_RATELIMIT_ENABLED=true
