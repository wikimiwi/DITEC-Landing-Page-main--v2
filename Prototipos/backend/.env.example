# ============================================================
# DITEC — variaveis de ambiente do backend.
# Copie para .env (desenvolvimento local) ou cadastre no painel da
# hospedagem (producao). NUNCA versione valores reais.
# Valores entre aspas para o shell aceitar caracteres como "&".
# ============================================================

# --- Perfil: dev (local) | prod (hospedagem) ---
DITEC_PROFILE="dev"

# --- Banco MySQL (OBRIGATORIO) ---
DB_URL="jdbc:mysql://localhost:3306/ditec_assistencia?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true"
DB_USERNAME="ditec_user"
DB_PASSWORD=""

# --- JWT (OBRIGATORIO, minimo 32 caracteres): openssl rand -base64 48 ---
JWT_SECRET=""
JWT_EXPIRATION_MINUTES="120"

# --- Front-end autorizado (CORS) ---
# Producao: URL publica do site, ex. https://usuario.github.io
FRONTEND_URL=""
# Opcional: varias origens separadas por virgula (tem prioridade sobre FRONTEND_URL)
DITEC_ALLOWED_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# --- Chatbot (Google Gemini API) ---
# Crie a chave em https://aistudio.google.com/apikey (Google AI Studio).
# Sem ela o chatbot responde em modo automatico (FAQ oficial). NUNCA exponha no front-end.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_READ_TIMEOUT_MS="15000"

# --- Seguranca / operacao ---
DITEC_SEED_ENABLED="true"         # contas de demonstracao (ignorado no perfil prod)
DITEC_RATELIMIT_ENABLED="true"
DITEC_TRUST_PROXY="false"         # true somente atras de proxy reverso confiavel
