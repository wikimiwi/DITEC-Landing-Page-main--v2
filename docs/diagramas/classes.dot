digraph G {
 rankdir=TB; nodesep=0.55; ranksep=0.85; splines=true; fontname="Liberation Sans";
 node [shape=plain, fontname="Liberation Sans", fontsize=13]; edge [fontname="Liberation Sans", fontsize=12, color="#444444", arrowsize=0.8];
 Usuario [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6eef6"><B>Usuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ id: Long</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nome: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ email: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- senhaHash: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ telefone: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tipo: TipoUsuario</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ status: StatusConta</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ultimoAcesso: LocalDateTime</TD></TR></TABLE>>];
 Cliente [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6eef6"><B>Cliente</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ endereco: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ bairro: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cidade: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ uf: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cep: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ complemento: String</TD></TR></TABLE>>];
 Tecnico [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6eef6"><B>Tecnico</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nome: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ especialidade: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ certificacao: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ telefone: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ email: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ status: StatusConta</TD></TR></TABLE>>];
 Servico [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6eef6"><B>Servico</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nome: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ descricao: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ valorBase: BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ status: StatusConta</TD></TR></TABLE>>];
 Agendamento [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6eef6"><B>Agendamento</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ protocolo: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nomeContato: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ telefoneContato: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ dataHora: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tipoAparelho: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ bairro: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ endereco: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ prioridadeGas: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ status: StatusAgendamento</TD></TR></TABLE>>];
 OrdemServico [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6eef6"><B>OrdemServico</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ protocolo: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ status: StatusOS</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ diagnostico: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ valorOrcamento: BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ orcamentoAprovado: Boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ previsaoConclusao: LocalDate</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ valor: BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ formaPagamento: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ desconto: BigDecimal</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ garantiaDias: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ dataConclusao: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ dataEntrega: LocalDateTime</TD></TR></TABLE>>];
 TimelineOS [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6eef6"><B>TimelineOS</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tipo: TipoEventoOS</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ statusAnterior: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ statusNovo: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ observacao: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ visivelCliente: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ dataHora: LocalDateTime</TD></TR></TABLE>>];
 Avaliacao [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6eef6"><B>Avaliacao</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nota: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ comentario: String</TD></TR></TABLE>>];
 ChatLog [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#e6eef6"><B>ChatLog</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ sessaoId: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ pergunta: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ resposta: String</TD></TR></TABLE>>];
 StatusOS [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f3ece0"><FONT POINT-SIZE="11">«enumeration»</FONT><BR/><B>StatusOS</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">AGENDADO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">EM_DIAGNOSTICO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AGUARDANDO_APROVACAO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AGUARDANDO_PECAS</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">EM_MANUTENCAO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">EM_TESTES</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CONCLUIDO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AGUARDANDO_RETIRADA</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ENTREGUE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CANCELADO</TD></TR><HR/><TR><TD ALIGN="LEFT">+ podeTransicionarPara(novo) boolean</TD></TR><TR><TD ALIGN="LEFT">+ isTerminal() boolean</TD></TR></TABLE>>];
 TipoUsuario [label=<<TABLE BORDER="1" COLOR="#555555" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD BGCOLOR="#f3ece0"><FONT POINT-SIZE="11">«enumeration»</FONT><BR/><B>TipoUsuario</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">CLIENTE</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">TECNICO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ADMINISTRADOR</TD></TR></TABLE>>];
 Cliente -> Usuario [label=" perfil de ", taillabel="0..1", headlabel="1", arrowhead=vee, labeldistance=1.6];
 Tecnico -> Usuario [label=" perfil de ", taillabel="0..1", headlabel="1", arrowhead=vee, labeldistance=1.6];
 Usuario -> TipoUsuario [style=dashed, arrowhead=vee, labeldistance=1.6];
 Cliente -> Agendamento [label=" solicita ", taillabel="0..1", headlabel="0..*", arrowhead=vee, labeldistance=1.6];
 Tecnico -> Agendamento [label=" atende ", taillabel="0..1", headlabel="0..*", arrowhead=vee, labeldistance=1.6];
 Servico -> Agendamento [label=" classifica ", taillabel="0..1", headlabel="0..*", arrowhead=vee, labeldistance=1.6];
 Agendamento -> OrdemServico [label=" gera ", taillabel="1", headlabel="0..1", arrowhead=vee, labeldistance=1.6];
 Tecnico -> OrdemServico [label=" executa ", taillabel="0..1", headlabel="0..*", arrowhead=vee, labeldistance=1.6];
 Cliente -> OrdemServico [label=" acompanha ", taillabel="0..1", headlabel="0..*", arrowhead=vee, labeldistance=1.6];
 OrdemServico -> TimelineOS [label=" histórico ", taillabel="1", headlabel="0..*", dir=both, arrowtail=diamond, arrowhead=vee, labeldistance=1.6];
 Usuario -> TimelineOS [label=" autor ", taillabel="0..1", headlabel="0..*", arrowhead=vee, labeldistance=1.6];
 OrdemServico -> Avaliacao [label=" recebe ", taillabel="1", headlabel="0..1", arrowhead=vee, labeldistance=1.6];
 Cliente -> Avaliacao [label=" emite ", taillabel="0..1", headlabel="0..*", arrowhead=vee, labeldistance=1.6];
 Cliente -> ChatLog [label=" origina ", taillabel="0..1", headlabel="0..*", arrowhead=vee, labeldistance=1.6];
 OrdemServico -> StatusOS [style=dashed, arrowhead=vee, labeldistance=1.6];
}