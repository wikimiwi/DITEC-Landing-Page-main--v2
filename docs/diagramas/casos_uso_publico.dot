digraph G {
  rankdir=LR; fontname="Liberation Sans"; nodesep=0.35; ranksep=1.1; splines=true;
  node [fontname="Liberation Sans", fontsize=12];
  edge [arrowhead=none, color="#444444"];
  subgraph cluster_sis { label="Sistema DITEC Assistência Técnica"; style=rounded; color="#555555"; fontsize=14;
    node [shape=ellipse, style=filled, fillcolor="#eef3f8", color="#355c7d"];
    CU01 [label="CU01 Consultar site,\nserviços e área de atendimento"];
    CU02 [label="CU02 Agendar visita técnica"];
    CU03 [label="CU03 Rastrear ordem de serviço"];
    CU04 [label="CU04 Conversar com o\nassistente virtual"];
    CU05 [label="CU05 Criar conta"];
    CU06 [label="CU06 Autenticar-se"];
    CU07 [label="CU07 Gerir perfil e endereço"];
    CU08 [label="CU08 Gerir agendamentos"];
    CU09 [label="CU09 Consultar ordens de serviço\ne histórico"];
